# Copiar a .env (nunca commitearlo) o cargar como GitHub Secrets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE_APP=
# Opcional: remitente visible, p. ej. "Interfaz 4 · Apiario <cuenta@gmail.com>"
SMTP_REMITENTE=
CORREO_DESTINO_POR_DEFECTO=
# Opcional: correo por responsable, p. ej. "Eduardo Mendoza=correo@x.com; Rocío Barni=otro@y.com"
CORREOS_RESPONSABLES=
# Opcional (Google Workspace con webhooks entrantes habilitados)
GCHAT_WEBHOOK_URL=
# Opcional: identificación ante MET Norway (nombre/versión + contacto)
METNO_USER_AGENT="interfaz4-apiarios/0.1 (+https://github.com/eduabejas/apiario-portal)"
